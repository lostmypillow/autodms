{
    "name": "autodms",
    "version": "2.1.3",
    "type": "module",
    "license": "GNU AGPLv3",
    "author": "lostmypillow",
    "homepage": "https://github.com/lostmypillow/autodms#readme",
    "bugs": {
        "url": "https://github.com/lostmypillow/autodms/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lostmypillow/autodms.git"
    },
    "workspaces": [
        "api",
        "frontend",
        "extension",
        "shared"
    ],
    "overrides": {
        "uuid": "^14.0.2"
    },
    "scripts": {
        "ci": "pnpm run lint && pnpm run test",
        "lint": "node ./node_modules/ts7/bin/tsc -b --noEmit && eslint . --ignore-pattern 'coverage/**' && node ./node_modules/ts7/bin/tsc -b --clean",
        "test": "vitest run --coverage",
        "e2e:local": "docker compose down && docker compose up -d --build && playwright install && node -e \"setTimeout(()=>{}, 2000)\" && playwright test; docker compose down",
        "e2e:debug": "docker compose down && docker compose up -d --build && playwright install && playwright test --ui; docker compose down",
        "e2e:ci": "playwright test"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.7.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@types/aws-lambda": "^8.10.162",
        "@types/cheerio": "^1.0.0",
        "@types/chrome": "^0.3.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/debug": "^4.1.13",
        "@types/express": "^5.0.6",
        "@types/firefox-webext-browser": "^143.0.0",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.2.0",
        "@types/ws": "^8.18.2",
        "@vitest/coverage-v8": "^4.1.11",
        "autoprefixer": "^10.4.20",
        "aws-cdk": "2.1138.0",
        "aws-sdk-client-mock": "^4.1.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "jiti": "^2.6.1",
        "nodemon": "^3.1.14",
        "oxlint": "^1.85.0",
        "postcss": "^8.5.15",
        "prettier": "^3.9.6",
        "tailwindcss": "^3.4.13",
        "ts-node": "^10.9.2",
        "ts7": "npm:typescript@^7.0.2",
        "tsx": "^4.23.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.0",
        "vitest": "^4.1.0",
        "vue-tsc": "^3.3.12",
        "web-ext": "^10.7.0"
    }
}
